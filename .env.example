# Salin file ini jadi .env.local lalu isi nilainya.
# Ambil dari Supabase Dashboard > Project Settings > API.

# Di versi source ini variabel masih bernama ANON_KEY; nilainya boleh diisi sb_publishable_...
# Aman dipakai di browser bila setiap tabel dilindungi RLS dan policy benar.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ganti_dengan_key_project

# URL situs (link reset password, redirect login). Lokal: http://localhost:3000
# Produksi: https://domain-kamu.com  (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Aplikasi ini TIDAK memakai service-role key. Jangan menambahkannya, apalagi dengan awalan NEXT_PUBLIC_.
